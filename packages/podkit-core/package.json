{
  "name": "@podkit/core",
  "version": "0.6.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external koffi --external usb --external @podkit/ipod-firmware && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "test": "true",
    "test:unit": "bun test --pass-with-no-tests",
    "test:integration": "gpod-tests-parallel",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ctrl/video-filename-parser": "^5.4.1",
    "@podkit/device-types": "workspace:*",
    "@podkit/devices-ipod": "workspace:*",
    "@podkit/devices-mass-storage": "workspace:*",
    "@podkit/ipod-firmware": "workspace:*",
    "@podkit/libgpod-node": "workspace:*",
    "glob": "^13.0.6",
    "music-metadata": "^11.12.1",
    "node-taglib-sharp": "^6.0.1",
    "subsonic-api": "^3.2.0"
  },
  "devDependencies": {
    "@podkit/gpod-testing": "workspace:*",
    "@podkit/test-fixtures": "workspace:*",
    "@types/bun": "latest",
    "bun-types": "latest"
  }
}
