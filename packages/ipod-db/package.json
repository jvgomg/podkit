{
  "name": "@podkit/ipod-db",
  "version": "0.0.1",
  "description": "Pure TypeScript iTunesDB parser for iPod devices",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "generate-fixtures": "bun run fixtures/generate.ts",
    "test": "true",
    "test:unit": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@podkit/gpod-testing": "workspace:*",
    "@podkit/libgpod-node": "workspace:*",
    "@types/bun": "latest",
    "bun-types": "latest"
  }
}
