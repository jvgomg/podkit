{
  "name": "@podkit/daemon",
  "private": true,
  "version": "0.2.2",
  "description": "Daemon for auto-detecting iPods and syncing via the podkit CLI",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target node && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "compile": "bun build src/main.ts --compile --outfile bin/podkit-daemon",
    "test": "true",
    "test:unit": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist bin"
  },
  "dependencies": {
    "@podkit/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest"
  }
}
