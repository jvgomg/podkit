{
  "name": "podkit",
  "version": "0.6.0",
  "type": "module",
  "bin": {
    "podkit": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": "./dist/main.js",
    "./types": "./src/types.ts"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target node --define PODKIT_VERSION=\"'$(jq -r .version package.json)'\" && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "dev": "bun run src/main.ts",
    "test": "true",
    "test:unit": "bun test --pass-with-no-tests",
    "test:integration": "bun test --pass-with-no-tests --path-ignore-patterns= .integration.",
    "compile": "bash scripts/compile.sh",
    "install:dev": "bash scripts/install-dev.sh",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist bin"
  },
  "dependencies": {
    "@podkit/core": "workspace:*",
    "@podkit/libgpod-node": "workspace:*",
    "commander": "^14.0.3",
    "smol-toml": "^1.6.0"
  },
  "devDependencies": {
    "@podkit/gpod-testing": "workspace:*",
    "@types/bun": "latest"
  }
}
