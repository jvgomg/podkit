{
  "name": "@podkit/test-fixtures",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "scripts": {
    "generate-fixtures": "bun run src/index.ts",
    "build": "bun run build:types && bun run build:bundle",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "bun build src/index.ts src/lib.ts --outdir dist --target node",
    "check-ffmpeg": "bun run scripts/check-ffmpeg.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
