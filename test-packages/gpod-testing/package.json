{
  "name": "@podkit/gpod-testing",
  "private": true,
  "version": "0.0.0",
  "description": "Test utilities for creating and managing iPod test environments",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "bin"
  ],
  "bin": {
    "gpod-tests-parallel": "./scripts/run-tests-parallel.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "build:linux-binary": "bash ../../test-packages/device-testing/scripts/build-gpod-tool-linux.sh",
    "generate-templates": "bun run scripts/generate-templates.ts",
    "test": "true",
    "test:unit": "bun test --pass-with-no-tests",
    "test:integration": "bun test --pass-with-no-tests --path-ignore-patterns= .integration.",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist templates bin"
  },
  "devDependencies": {
    "@podkit/test-fixtures": "workspace:*",
    "@types/bun": "latest",
    "bun-types": "latest"
  }
}
