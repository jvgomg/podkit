{
  "name": "@podkit/e2e-host-tests",
  "version": "0.0.0",
  "description": "End-to-end tests for the podkit CLI (directory sources; no Docker harness).",
  "type": "module",
  "private": true,
  "exports": {
    "./helpers/fixtures": "./src/helpers/fixtures.ts",
    "./helpers/video-fixtures": "./src/helpers/video-fixtures.ts",
    "./targets": "./src/targets/index.ts"
  },
  "scripts": {
    "test": "bun run src/scripts/run-parallel.ts",
    "test:serial": "bun test",
    "test:dummy": "IPOD_TARGET=dummy bun run src/scripts/run-parallel.ts",
    "test:real": "IPOD_TARGET=real bun test",
    "preflight": "bun run src/helpers/preflight.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@podkit/compatibility": "workspace:*",
    "@podkit/e2e-shared": "workspace:*",
    "@podkit/gpod-testing": "workspace:*",
    "@podkit/test-fixtures": "workspace:*",
    "podkit": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest"
  }
}
