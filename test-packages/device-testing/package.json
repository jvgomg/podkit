{
  "name": "@podkit/device-testing",
  "version": "0.0.1",
  "description": "Device persona + system-state fixtures and test runtime harness for podkit's VM integration tests",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "podkit-vm-preflight": "./scripts/preflight-vm.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external @podkit/core --external @podkit/device-types && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "test": "true",
    "test:unit": "bun test --pass-with-no-tests",
    "test:vm": "bun run scripts/preflight-vm.ts && bun test src/vm --path-ignore-patterns= --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build:linux-prebuild": "bash scripts/build-linux-prebuild.sh",
    "build:linux-binary": "bash scripts/build-linux-binary.sh",
    "build:backing-file": "bun run scripts/build-backing-file.ts",
    "transfer-binary": "bun run scripts/transfer-binary.ts",
    "harness:create": "bun run scripts/harness.ts create",
    "harness:start": "bun run scripts/harness.ts start",
    "harness:stop": "bun run scripts/harness.ts stop",
    "harness:destroy": "bun run scripts/harness.ts destroy",
    "harness:shell": "bun run scripts/harness.ts shell",
    "harness:status": "bun run scripts/harness.ts status",
    "harness:install": "bun run scripts/harness.ts install",
    "harness:setup": "bun run scripts/harness.ts setup",
    "harness:builder:stop": "bun run scripts/harness.ts builder:stop",
    "harness:builder:destroy": "bun run scripts/harness.ts builder:destroy"
  },
  "dependencies": {
    "@podkit/core": "workspace:*",
    "@podkit/device-types": "workspace:*"
  },
  "devDependencies": {
    "@podkit/ipod-db": "workspace:*",
    "@podkit/ipod-firmware": "workspace:*",
    "@types/bun": "latest",
    "bun-types": "latest"
  }
}
