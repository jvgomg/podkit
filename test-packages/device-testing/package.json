{
  "name": "@podkit/device-testing",
  "version": "0.0.1",
  "description": "Device persona + system-state fixtures and test runtime harness for podkit's VM integration tests",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preflight": "./src/preflight.ts"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "bin": {
    "assert-min-tests": "./scripts/assert-min-tests.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external @podkit/core --external @podkit/device-types --external @podkit/lima --external @podkit/substrate && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "test": "true",
    "test:unit": "bun run scripts/assert-min-tests.ts --pass-with-no-tests",
    "test:vm": "bun test src/vm --path-ignore-patterns= --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build:linux-prebuild": "bun run scripts/build-artifacts.ts glibcPrebuild",
    "build:linux-binary": "bun run scripts/build-artifacts.ts glibcBinary",
    "build:musl-prebuild": "bun run scripts/build-artifacts.ts muslPrebuild",
    "build:musl-binary": "bun run scripts/build-artifacts.ts muslBinary",
    "build:backing-file": "bun run scripts/build-backing-file.ts",
    "transfer-binary": "bun run scripts/transfer-binary.ts",
    "vm:install": "bun run scripts/vm-install.ts",
    "vm:doctor": "bun run scripts/vm-doctor.ts",
    "harness:status": "bun run scripts/harness.ts status",
    "harness:install": "bun run scripts/harness.ts install",
    "harness:setup": "bun run scripts/harness.ts setup",
    "harness:seal": "bun run scripts/substrate-seal.ts"
  },
  "dependencies": {
    "@podkit/core": "workspace:*",
    "@podkit/device-types": "workspace:*",
    "@podkit/lima": "workspace:*",
    "@podkit/substrate": "workspace:*"
  },
  "devDependencies": {
    "@podkit/ipod-db": "workspace:*",
    "@podkit/ipod-firmware": "workspace:*",
    "@types/bun": "^1.4.2",
    "bun-types": "latest"
  }
}
