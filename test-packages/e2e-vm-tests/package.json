{
  "name": "@podkit/e2e-vm-tests",
  "version": "0.0.0",
  "description": "End-to-end VM tests for podkit features running against the @podkit/device-testing harness",
  "type": "module",
  "private": true,
  "scripts": {
    "test:vm": "podkit-vm-preflight && bun test src/ --path-ignore-patterns= --pass-with-no-tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@podkit/core": "workspace:*",
    "@podkit/device-testing": "workspace:*",
    "@podkit/device-types": "workspace:*"
  },
  "devDependencies": {
    "@podkit/ipod-db": "workspace:*",
    "@podkit/ipod-firmware": "workspace:*",
    "@types/bun": "latest",
    "bun-types": "latest"
  }
}
