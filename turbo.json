{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["PODKIT_DISABLE_TEMPLATE_CACHE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/__tests__/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": ["dist/**"]
    },
    "@podkit/libgpod-node#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/__tests__/**",
        "native/**",
        "binding.gyp",
        "scripts/has-prebuild.cjs",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": ["dist/**", "build/**", "prebuilds/**"]
    },
    "@podkit/ipod-web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/__tests__/**",
        "index.html",
        "vite.config.ts",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": ["dist/**"]
    },
    "@podkit/virtual-ipod-app#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "index.html", "vite.config.ts", "package.json", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "@podkit/docs-site#test": { "dependsOn": [] },
    "@podkit/docs-site#test:unit": { "dependsOn": [] },
    "@podkit/docs-site#test:integration": { "dependsOn": [] },
    "@podkit/demo#test": { "dependsOn": [] },
    "@podkit/demo#test:unit": { "dependsOn": [] },
    "@podkit/demo#test:integration": { "dependsOn": [] },
    "@podkit/demo#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "!src/**/*.test.ts", "build.ts", "package.json", "tsconfig.json"],
      "outputs": ["bin/**"]
    },
    "test": {
      "dependsOn": ["test:unit", "test:integration"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["build", "^build"],
      "inputs": [
        "src/**",
        "!src/**/*.integration.test.ts",
        "!src/**/*.perf.test.ts",
        "!src/**/*.e2e.test.ts",
        "test/preload.ts",
        "bunfig.toml",
        "package.json"
      ],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": [
        "build",
        "^build",
        "@podkit/gpod-testing#generate-templates",
        "@podkit/test-fixtures#generate-static-fixtures"
      ],
      "inputs": ["src/**", "!src/**/*.perf.test.ts", "test/**", "bunfig.toml", "package.json"],
      "outputs": []
    },
    "test:perf": {
      "dependsOn": [
        "build",
        "^build",
        "@podkit/gpod-testing#generate-templates",
        "@podkit/test-fixtures#generate-static-fixtures"
      ],
      "inputs": ["src/**/*.perf.test.ts", "src/**", "test/**", "bunfig.toml", "package.json"],
      "outputs": [],
      "cache": false
    },
    "@podkit/e2e-host-tests#test": {
      "dependsOn": [
        "^build",
        "@podkit/gpod-testing#generate-templates",
        "@podkit/test-fixtures#generate-static-fixtures"
      ],
      "inputs": ["src/**"],
      "outputs": []
    },
    "@podkit/e2e-host-tests#test:unit": { "dependsOn": [] },
    "@podkit/e2e-host-tests#test:integration": { "dependsOn": [] },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": []
    },
    "compile": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "!src/**/*.test.ts", "!src/__tests__/**", "package.json"],
      "outputs": ["bin/**"]
    },
    "record": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "build.ts", "demo.tape", "run.sh", "package.json"],
      "outputs": ["demo.gif"]
    },
    "@podkit/gpod-testing#test:integration": {
      "dependsOn": ["build", "generate-templates"],
      "inputs": ["src/**"],
      "outputs": []
    },
    "@podkit/gpod-testing#generate-templates": {
      "dependsOn": [],
      "inputs": [
        "scripts/generate-templates.ts",
        "src/templates.ts",
        "src/test-ipod.ts",
        "src/gpod-tool.ts",
        "$TURBO_ROOT$/bin/gpod-tool"
      ],
      "outputs": ["templates/**"],
      "cache": true
    },
    "@podkit/ipod-db#generate-fixtures": {
      "dependsOn": ["^build", "@podkit/gpod-testing#generate-templates"],
      "inputs": ["fixtures/generate.ts"],
      "outputs": ["fixtures/databases/**"],
      "cache": true
    },
    "@podkit/ipod-db#test:unit": {
      "dependsOn": ["build", "generate-fixtures"],
      "inputs": ["src/**", "__tests__/**", "!src/**/*.integration.test.ts"],
      "outputs": []
    },
    "@podkit/ipod-db#test:integration": {
      "dependsOn": ["build", "generate-fixtures", "@podkit/gpod-testing#generate-templates"],
      "inputs": ["src/**", "__tests__/**"],
      "outputs": []
    },
    "@podkit/test-fixtures#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "scripts/check-ffmpeg.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": ["dist/**"]
    },
    "@podkit/test-fixtures#generate-fixtures": {
      "inputs": ["src/**", "scripts/generate-fixtures.ts"],
      "outputs": ["../../test/manual-collection/**"],
      "cache": true
    },
    "@podkit/test-fixtures#generate-static-fixtures": {
      "inputs": ["src/static/**", "src/encoder-guard.ts", "scripts/generate-static-fixtures.ts"],
      "outputs": ["fixtures/**"],
      "cache": true
    },
    "@podkit/device-testing#test:vm": {
      "dependsOn": ["build", "^build"],
      "cache": true,
      "inputs": [
        "src/vm/**",
        "src/personas/**",
        "src/system-states/**",
        "src/runners/**",
        "src/runtime.ts",
        "src/subprocess.ts",
        "$TURBO_ROOT$/test-packages/device-testing/lima/**",
        "$TURBO_ROOT$/test-packages/device-testing/scripts/apply-state.sh",
        "package.json",
        "bunfig.toml"
      ],
      "outputs": []
    },
    "@podkit/e2e-vm-tests#test:vm": {
      "dependsOn": [
        "@podkit/device-testing-daemon#build",
        "^build",
        "@podkit/device-testing#test:vm"
      ],
      "cache": true,
      "inputs": [
        "src/**",
        "$TURBO_ROOT$/test-packages/device-testing/src/**",
        "$TURBO_ROOT$/test-packages/device-testing/lima/**",
        "$TURBO_ROOT$/test-packages/device-testing/scripts/apply-state.sh",
        "package.json",
        "bunfig.toml"
      ],
      "outputs": []
    },
    "@podkit/device-testing#build:linux-prebuild": {
      "dependsOn": [],
      "env": ["PODKIT_HOST_ARCH"],
      "inputs": [
        "$TURBO_ROOT$/packages/libgpod-node/native/**",
        "$TURBO_ROOT$/packages/libgpod-node/binding.gyp",
        "$TURBO_ROOT$/packages/libgpod-node/scripts/has-prebuild.cjs",
        "$TURBO_ROOT$/tools/prebuild/build-static-deps.sh",
        "$TURBO_ROOT$/tools/prebuild/build-linux-glibc.sh",
        "$TURBO_ROOT$/tools/prebuild/get-cflags.sh",
        "$TURBO_ROOT$/tools/prebuild/get-ldflags.sh",
        "$TURBO_ROOT$/test-packages/device-testing/lima/podkit-linux-builder.yaml",
        "scripts/build-linux-prebuild.sh"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/libgpod-node/prebuilds/linux-x64/**",
        "$TURBO_ROOT$/packages/libgpod-node/prebuilds/linux-arm64/**"
      ]
    },
    "@podkit/device-testing-daemon#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/build.sh", "package.json", "tsconfig.json"],
      "outputs": ["dist/dummy-hcd-daemon-linux-*"]
    },
    "@podkit/device-testing#build:linux-binary": {
      "dependsOn": ["@podkit/device-testing#build:linux-prebuild", "^build"],
      "env": ["PODKIT_HOST_ARCH"],
      "inputs": [
        "$TURBO_ROOT$/packages/*/src/**",
        "!$TURBO_ROOT$/packages/*/src/**/*.test.ts",
        "!$TURBO_ROOT$/packages/*/__tests__/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/*/tsconfig.build.json",
        "$TURBO_ROOT$/packages/podkit-cli/scripts/compile.sh",
        "$TURBO_ROOT$/packages/libgpod-node/prebuilds/linux-x64/**",
        "$TURBO_ROOT$/packages/libgpod-node/prebuilds/linux-arm64/**",
        "$TURBO_ROOT$/test-packages/device-testing/lima/podkit-linux-builder.yaml",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "scripts/build-linux-binary.sh"
      ],
      "outputs": ["$TURBO_ROOT$/packages/podkit-cli/bin/podkit-linux-*"]
    },
    "@podkit/gpod-testing#build:linux-binary": {
      "dependsOn": [],
      "env": ["PODKIT_HOST_ARCH"],
      "inputs": [
        "$TURBO_ROOT$/tools/gpod-tool/**",
        "$TURBO_ROOT$/test-packages/device-testing/lima/podkit-linux-builder.yaml",
        "$TURBO_ROOT$/test-packages/device-testing/scripts/build-gpod-tool-linux.sh"
      ],
      "outputs": ["bin/gpod-tool-linux-*"]
    },
    "clean": {
      "cache": false
    }
  }
}
