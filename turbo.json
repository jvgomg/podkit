{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "PODKIT_DISABLE_TEMPLATE_CACHE",
    "PODKIT_DOCKER_DIST_IMAGE",
    "PODKIT_LINUX_BINARY",
    "PODKIT_LINUX_MUSL_BINARY",
    "PODKIT_DAEMON_LINUX_BINARY",
    "PODKIT_DAEMON_LINUX_MUSL_BINARY",
    "PODKIT_CLI_BINARY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/__tests__/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": ["dist/**"]
    },
    "@podkit/libgpod-node#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/__tests__/**",
        "native/**",
        "binding.gyp",
        "scripts/has-prebuild.cjs",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": ["dist/**", "build/**", "prebuilds/**"]
    },
    "@podkit/ipod-web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/__tests__/**",
        "index.html",
        "vite.config.ts",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": ["dist/**"]
    },
    "@podkit/virtual-ipod-app#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "index.html", "vite.config.ts", "package.json", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "@podkit/demo#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "!src/**/*.test.ts", "build.ts", "package.json", "tsconfig.json"],
      "outputs": ["bin/**"]
    },
    "test": {
      "dependsOn": ["test:unit", "test:integration"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["build", "^build"],
      "inputs": [
        "src/**",
        "!src/**/*.integration.test.ts",
        "!src/**/*.perf.test.ts",
        "!src/**/*.e2e.test.ts",
        "bunfig.toml",
        "package.json"
      ],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": [
        "build",
        "^build",
        "@podkit/gpod-testing#generate-templates",
        "@podkit/test-fixtures#generate-static-fixtures"
      ],
      "inputs": ["src/**", "!src/**/*.perf.test.ts", "test/**", "bunfig.toml", "package.json"],
      "outputs": []
    },
    "test:perf": {
      "dependsOn": [
        "build",
        "^build",
        "@podkit/gpod-testing#generate-templates",
        "@podkit/test-fixtures#generate-static-fixtures"
      ],
      "inputs": ["src/**/*.perf.test.ts", "src/**", "test/**", "bunfig.toml", "package.json"],
      "outputs": [],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": [],
      "outputs": []
    },
    "test:e2e:docker": {
      "dependsOn": [],
      "outputs": []
    },
    "test:vm": {
      "dependsOn": [],
      "outputs": []
    },
    "@podkit/e2e-tests#test:e2e": {
      "dependsOn": [
        "^build",
        "podkit#compile",
        "podkit#compile:debug",
        "@podkit/gpod-testing#generate-templates",
        "@podkit/test-fixtures#generate-static-fixtures"
      ],
      "inputs": ["src/**"],
      "outputs": []
    },
    "@podkit/e2e-tests#test:e2e:docker": {
      "dependsOn": [
        "^build",
        "podkit#compile",
        "podkit#compile:debug",
        "@podkit/gpod-testing#generate-templates",
        "@podkit/test-fixtures#generate-static-fixtures"
      ],
      "inputs": ["src/**"],
      "outputs": []
    },
    "@podkit/e2e-tests#test:e2e:docker-loopback": {
      "dependsOn": ["^build", "@podkit/device-testing#build:musl-binary"],
      "cache": false,
      "inputs": ["src/**", "package.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": []
    },
    "compile": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/__tests__/**",
        "scripts/compile.sh",
        "scripts/select-gpod-prebuild.sh",
        "package.json"
      ],
      "outputs": ["bin/podkit"]
    },
    "compile:debug": {
      "dependsOn": ["^build"],
      "env": ["PODKIT_DEV_HOOKS"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/__tests__/**",
        "scripts/compile.sh",
        "scripts/select-gpod-prebuild.sh",
        "package.json"
      ],
      "outputs": ["bin/podkit-debug"]
    },
    "record": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "build.ts", "demo.tape", "run.sh", "package.json"],
      "outputs": ["demo.gif"]
    },
    "@podkit/gpod-testing#test:integration": {
      "dependsOn": ["build", "generate-templates"],
      "inputs": ["src/**"],
      "outputs": []
    },
    "@podkit/gpod-testing#generate-templates": {
      "dependsOn": [],
      "inputs": [
        "scripts/generate-templates.ts",
        "src/templates.ts",
        "src/test-ipod.ts",
        "src/gpod-tool.ts",
        "$TURBO_ROOT$/bin/gpod-tool"
      ],
      "outputs": ["templates/**"],
      "cache": true
    },
    "@podkit/ipod-db#generate-fixtures": {
      "dependsOn": ["^build", "@podkit/gpod-testing#generate-templates"],
      "inputs": ["fixtures/generate.ts"],
      "outputs": ["fixtures/databases/**"],
      "cache": true
    },
    "@podkit/ipod-db#test:unit": {
      "dependsOn": ["build", "generate-fixtures"],
      "inputs": ["src/**", "__tests__/**", "!src/**/*.integration.test.ts"],
      "outputs": []
    },
    "@podkit/ipod-db#test:integration": {
      "dependsOn": ["build", "generate-fixtures", "@podkit/gpod-testing#generate-templates"],
      "inputs": ["src/**", "__tests__/**"],
      "outputs": []
    },
    "@podkit/test-fixtures#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "scripts/check-ffmpeg.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": ["dist/**"]
    },
    "@podkit/test-fixtures#generate-fixtures": {
      "inputs": ["src/**", "scripts/generate-fixtures.ts"],
      "outputs": ["../../test/manual-collection/**"],
      "cache": true
    },
    "@podkit/test-fixtures#generate-static-fixtures": {
      "inputs": ["src/static/**", "src/encoder-guard.ts", "scripts/generate-static-fixtures.ts"],
      "outputs": ["fixtures/**"],
      "cache": true
    },
    "@podkit/device-testing#test:vm": {
      "dependsOn": [
        "build",
        "^build",
        "@podkit/device-testing#vm:install",
        "@podkit/device-testing#vm:doctor"
      ],
      "cache": true,
      "inputs": [
        "src/vm/**",
        "src/personas/**",
        "src/system-states/**",
        "src/runners/**",
        "src/runtime.ts",
        "src/subprocess.ts",
        "$TURBO_ROOT$/test-packages/device-testing/lima/**",
        "$TURBO_ROOT$/test-packages/device-testing/scripts/apply-state.sh",
        "package.json",
        "bunfig.toml"
      ],
      "outputs": []
    },
    "@podkit/device-testing#vm:install": {
      "dependsOn": [
        "@podkit/device-testing#build:linux-binary",
        "@podkit/device-testing-daemon#build",
        "@podkit/gpod-testing#build:linux-binary"
      ],
      "env": ["PODKIT_HOST_ARCH"],
      "inputs": [
        "scripts/vm-install.ts",
        "scripts/harness.ts",
        "src/runners/lima-test-vm-binary.ts",
        "src/runners/lima-test-vm-systemd.ts",
        "src/runners/lima-test-vm.ts",
        "src/runners/lima-limactl.ts",
        "src/subprocess.ts",
        "src/baseline-hash.ts",
        "package.json",
        "$TURBO_ROOT$/packages/podkit-cli/bin/podkit-linux-*",
        "$TURBO_ROOT$/packages/podkit-cli/bin/podkit-debug-linux-*",
        "$TURBO_ROOT$/test-packages/device-testing-daemon/dist/dummy-hcd-daemon-linux-*",
        "$TURBO_ROOT$/test-packages/gpod-testing/bin/gpod-tool-linux-*",
        "$TURBO_ROOT$/test-packages/device-testing-daemon/dummy-hcd-daemon@.service"
      ],
      "outputs": [".turbo/vm-install-marker"],
      "cache": true
    },
    "@podkit/device-testing#vm:doctor": {
      "dependsOn": [],
      "inputs": [
        "scripts/vm-doctor.ts",
        "src/baseline-hash.ts",
        "src/runners/lima-test-vm.ts",
        "src/runners/lima-limactl.ts",
        "src/subprocess.ts",
        "lima/podkit-device-harness.yaml",
        "scripts/apply-state.sh"
      ],
      "outputs": [],
      "cache": false
    },
    "@podkit/e2e-vm-tests#test:vm": {
      "dependsOn": [
        "@podkit/device-testing-daemon#build",
        "^build",
        "podkit#compile",
        "podkit#compile:debug",
        "@podkit/device-testing#test:vm",
        "@podkit/device-testing#vm:install",
        "@podkit/device-testing#vm:doctor"
      ],
      "cache": true,
      "inputs": [
        "src/**",
        "$TURBO_ROOT$/test-packages/device-testing/src/**",
        "$TURBO_ROOT$/test-packages/device-testing/lima/**",
        "$TURBO_ROOT$/test-packages/device-testing/scripts/apply-state.sh",
        "package.json",
        "bunfig.toml"
      ],
      "outputs": []
    },
    "@podkit/e2e-vm-tests#test:e2e:docker-dist": {
      "dependsOn": [
        "@podkit/device-testing-daemon#build",
        "^build",
        "podkit#compile",
        "podkit#compile:debug",
        "@podkit/device-testing#build:musl-binary",
        "@podkit/device-testing#vm:install",
        "@podkit/device-testing#vm:doctor"
      ],
      "cache": false,
      "inputs": [
        "src/**",
        "$TURBO_ROOT$/test-packages/device-testing/src/**",
        "$TURBO_ROOT$/test-packages/device-testing/lima/**",
        "$TURBO_ROOT$/test-packages/device-testing/scripts/apply-state.sh",
        "package.json",
        "bunfig.toml"
      ],
      "outputs": []
    },
    "@podkit/device-testing#build:linux-prebuild": {
      "dependsOn": [],
      "env": ["PODKIT_HOST_ARCH"],
      "inputs": [
        "$TURBO_ROOT$/packages/libgpod-node/native/**",
        "$TURBO_ROOT$/packages/libgpod-node/binding.gyp",
        "$TURBO_ROOT$/packages/libgpod-node/scripts/has-prebuild.cjs",
        "$TURBO_ROOT$/packages/libgpod-node/package.json",
        "$TURBO_ROOT$/tools/prebuild/build-static-deps.sh",
        "$TURBO_ROOT$/tools/prebuild/build-linux-glibc.sh",
        "$TURBO_ROOT$/tools/prebuild/get-cflags.sh",
        "$TURBO_ROOT$/tools/prebuild/get-ldflags.sh",
        "$TURBO_ROOT$/test-packages/device-testing/lima/podkit-linux-builder.yaml",
        "$TURBO_ROOT$/bun.lock",
        "scripts/build-linux-prebuild.sh"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/libgpod-node/prebuilds/linux-x64/**",
        "$TURBO_ROOT$/packages/libgpod-node/prebuilds/linux-arm64/**"
      ]
    },
    "@podkit/device-testing-daemon#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/build.sh", "package.json", "tsconfig.json"],
      "outputs": ["dist/dummy-hcd-daemon-linux-*"]
    },
    "@podkit/device-testing#build:linux-binary": {
      "dependsOn": ["@podkit/device-testing#build:linux-prebuild", "^build"],
      "env": ["PODKIT_HOST_ARCH"],
      "inputs": [
        "$TURBO_ROOT$/packages/*/src/**",
        "!$TURBO_ROOT$/packages/*/src/**/*.test.ts",
        "!$TURBO_ROOT$/packages/*/__tests__/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/*/tsconfig.build.json",
        "$TURBO_ROOT$/packages/podkit-cli/scripts/compile.sh",
        "$TURBO_ROOT$/packages/podkit-cli/scripts/select-gpod-prebuild.sh",
        "$TURBO_ROOT$/packages/libgpod-node/prebuilds/linux-x64/**",
        "$TURBO_ROOT$/packages/libgpod-node/prebuilds/linux-arm64/**",
        "$TURBO_ROOT$/test-packages/device-testing/lima/podkit-linux-builder.yaml",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "scripts/build-linux-binary.sh"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/podkit-cli/bin/podkit-linux-*",
        "$TURBO_ROOT$/packages/podkit-cli/bin/podkit-debug-linux-*",
        "$TURBO_ROOT$/packages/podkit-daemon/bin/podkit-daemon-linux-*",
        "!$TURBO_ROOT$/packages/podkit-cli/bin/podkit-linux-*-musl",
        "!$TURBO_ROOT$/packages/podkit-cli/bin/podkit-debug-linux-*-musl",
        "!$TURBO_ROOT$/packages/podkit-daemon/bin/podkit-daemon-linux-*-musl"
      ]
    },
    "@podkit/device-testing#build:musl-prebuild": {
      "dependsOn": [],
      "env": ["PODKIT_HOST_ARCH"],
      "inputs": [
        "$TURBO_ROOT$/packages/libgpod-node/native/**",
        "$TURBO_ROOT$/packages/libgpod-node/binding.gyp",
        "$TURBO_ROOT$/packages/libgpod-node/scripts/has-prebuild.cjs",
        "$TURBO_ROOT$/packages/libgpod-node/package.json",
        "$TURBO_ROOT$/tools/prebuild/build-static-deps.sh",
        "$TURBO_ROOT$/tools/prebuild/build-linux-musl.sh",
        "$TURBO_ROOT$/tools/prebuild/get-cflags.sh",
        "$TURBO_ROOT$/tools/prebuild/get-ldflags.sh",
        "$TURBO_ROOT$/test-packages/device-testing/lima/podkit-musl-builder.yaml",
        "$TURBO_ROOT$/bun.lock",
        "scripts/build-musl-prebuild.sh"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/libgpod-node/prebuilds/linux-x64-musl/**",
        "$TURBO_ROOT$/packages/libgpod-node/prebuilds/linux-arm64-musl/**"
      ]
    },
    "@podkit/device-testing#build:musl-binary": {
      "dependsOn": ["@podkit/device-testing#build:musl-prebuild", "^build"],
      "env": ["PODKIT_HOST_ARCH"],
      "inputs": [
        "$TURBO_ROOT$/packages/*/src/**",
        "!$TURBO_ROOT$/packages/*/src/**/*.test.ts",
        "!$TURBO_ROOT$/packages/*/__tests__/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/*/tsconfig.build.json",
        "$TURBO_ROOT$/packages/podkit-cli/scripts/compile.sh",
        "$TURBO_ROOT$/packages/podkit-cli/scripts/select-gpod-prebuild.sh",
        "$TURBO_ROOT$/packages/libgpod-node/prebuilds/linux-x64-musl/**",
        "$TURBO_ROOT$/packages/libgpod-node/prebuilds/linux-arm64-musl/**",
        "$TURBO_ROOT$/test-packages/device-testing/lima/podkit-musl-builder.yaml",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "scripts/build-musl-binary.sh"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/podkit-cli/bin/podkit-linux-*-musl",
        "$TURBO_ROOT$/packages/podkit-cli/bin/podkit-debug-linux-*-musl",
        "$TURBO_ROOT$/packages/podkit-daemon/bin/podkit-daemon-linux-*-musl"
      ]
    },
    "@podkit/gpod-testing#build:linux-binary": {
      "dependsOn": [],
      "env": ["PODKIT_HOST_ARCH"],
      "inputs": [
        "$TURBO_ROOT$/tools/gpod-tool/**",
        "$TURBO_ROOT$/test-packages/device-testing/lima/podkit-linux-builder.yaml",
        "$TURBO_ROOT$/test-packages/device-testing/scripts/build-gpod-tool-linux.sh"
      ],
      "outputs": ["bin/gpod-tool-linux-*"]
    },
    "//#lint": {
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "**/*.mjs",
        "**/*.cjs",
        "oxlint.json"
      ],
      "outputs": []
    },
    "qa:fast": {
      "dependsOn": ["//#lint", "typecheck", "build"],
      "cache": false
    },
    "qa:test": {
      "dependsOn": ["qa:fast", "test"],
      "cache": false
    },
    "qa:e2e": {
      "dependsOn": ["qa:test", "test:e2e"],
      "cache": false
    },
    "qa:docker": {
      "dependsOn": ["qa:e2e", "test:e2e:docker"],
      "cache": false
    },
    "qa": {
      "dependsOn": ["qa:docker", "test:vm"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
