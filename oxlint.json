{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "rules": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "nursery": "off",
    "restriction": "off",
    "no-unused-vars": "error",
    "no-console": "warn",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.integration.test.ts", "**/*.e2e.test.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/e2e-host-tests/src/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "**/podkit-cli/src/config/**/*.ts",
        "**/podkit-cli/src/output/**/*.ts",
        "**/podkit-cli/src/commands/completions.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/scripts/*.cjs", "**/scripts/*.mjs", "**/scripts/*.js", "**/scripts/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/test-packages/device-testing-daemon/src/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/demo/build.ts", "**/demo/src/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/test-fixtures/src/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/virtual-ipod-server/src/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/ipod-db/fixtures/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/ipod-web/src/**/*.ts", "**/ipod-web/src/**/*.tsx"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/podkit-cli/src/main.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "**/podkit-cli/src/**/*.test.ts",
        "**/podkit-cli/src/**/*.unit.test.ts",
        "**/podkit-cli/src/**/*.integration.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:child_process",
                "message": "Spawning the podkit CLI as a subprocess is e2e-only. Put this test in test-packages/e2e-host-tests, or call the runner function in-process via runWithContext + runAction. See agents/testing.md."
              },
              {
                "name": "child_process",
                "message": "Spawning the podkit CLI as a subprocess is e2e-only. Put this test in test-packages/e2e-host-tests, or call the runner function in-process via runWithContext + runAction. See agents/testing.md."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["node_modules", "dist", "*.d.ts", "backlog", "docs"]
}
