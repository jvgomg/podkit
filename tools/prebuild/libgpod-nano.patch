+G_GNUC_INTERNAL gboolean
+itdb_device_is_hashab_nano (const Itdb_Device *device)
+{
+    return itdb_device_supports_sqlite_db (device)
+	&& !itdb_device_is_iphone_family (device)
+	&& itdb_device_get_checksum_type (device) == ITDB_CHECKSUM_HASHAB;
