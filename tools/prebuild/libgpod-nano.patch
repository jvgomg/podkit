+/* iPod nano 6G/7G: the dataset 5 playlists that are the firmware's
+   categories, stored as hidden smart containers */
+static GList *category_containers(Itdb_iTunesDB *itdb)
+{
+    GList *categories = NULL;
+    GList *gl;
+
+    if (!itdb_device_is_hashab_nano(itdb->device))
+	return NULL;
+    for (gl = itdb->priv->mhsd5_playlists; gl; gl = gl->next) {
+	Itdb_Playlist *pl = gl->data;
+	guint16 kind = pl->priv->distinguished_kind;
+	/* Videos 1, Movies 2, TV Shows 3, Music 4, Audiobooks 5, Rentals 7 */
+	if (kind < 8 && ((1 << kind) & 0xBE))
+	    categories = g_list_append(categories, pl);
+    }
+    return categories;
+}
