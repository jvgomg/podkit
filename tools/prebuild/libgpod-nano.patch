+/* The hidden smart playlists in mhsd type 5 that an iPod nano 6G/7G
+   firmware browses as Music, Videos, ... (iTunes' rules: the first selects
+   media kinds, the second excludes some) */
+static const struct {
+    guint16 kind;	/* mhyp +0x52 */
+    Itdb_Playlist_Mhsd5_Type mhsd5_type;
+    guint32 sortorder;
+    const gchar *name;
+    guint64 mask1;
+    guint32 action2;
+    guint64 mask2;
+} categories[] = {
+    {4, ITDB_PLAYLIST_MHSD5_MUSIC, 5, "Music", 0x1021B1,
+     ITDB_SPLACTION_NOT_BINARY_AND, 0x208004},
+    {1, ITDB_PLAYLIST_MHSD5_NONE, 1, "Videos", 0x000C42,
+     ITDB_SPLACTION_NOT_BINARY_AND, 0x20A004},
+    {2, ITDB_PLAYLIST_MHSD5_MOVIES, 1, "Movies", 0x000402,
+     ITDB_SPLACTION_NOT_BINARY_AND, 0x20A004},
+    {3, ITDB_PLAYLIST_MHSD5_TV_SHOWS, 1, "TV Shows", 0x000040,
+     ITDB_SPLACTION_NOT_BINARY_AND, 0x20A004},
+    {5, ITDB_PLAYLIST_MHSD5_AUDIOBOOKS, 1, "Audiobooks", 0x000008,
+     ITDB_SPLACTION_NOT_BINARY_AND, 0x20A004},
+    {7, ITDB_PLAYLIST_MHSD5_MOVIE_RENTALS, 1, "Rentals", 0x000042,
+     ITDB_SPLACTION_BINARY_UNKNOWN1, 0x008000},
+};
+
+/* Add the categories a nano 6G/7G library lacks, e.g. a new one. */
+G_GNUC_INTERNAL void itdb_playlist_add_missing_categories (Itdb_iTunesDB *itdb)
+{
+    guint i, j;
+
+    if (!itdb_device_is_hashab_nano (itdb->device))
+	return;
+    for (i = 0; i < G_N_ELEMENTS (categories); i++) {
+	Itdb_Playlist *pl;
+	GList *gl;
+
+	for (gl = itdb->priv->mhsd5_playlists; gl; gl = gl->next) {
+	    pl = gl->data;
+	    if (pl->priv->distinguished_kind == categories[i].kind)
+		break;
+	}
+	if (gl)
+	    continue;
+	pl = itdb_playlist_new (categories[i].name, FALSE);
+	pl->is_spl = TRUE;
+	pl->sortorder = categories[i].sortorder;
+	pl->splpref.liveupdate = TRUE;
+	pl->splpref.checkrules = TRUE;
+	pl->splpref.limittype = ITDB_LIMITTYPE_SONGS;
+	pl->splpref.limitsort = ITDB_LIMITSORT_RANDOM;
+	pl->splpref.limitvalue = 25;
+	pl->splrules.unk004 = 0x00010001;
+	pl->splrules.match_operator = ITDB_SPLMATCH_AND;
+	for (j = 0; j < 2; j++) {
+	    Itdb_SPLRule *splr = g_new0 (Itdb_SPLRule, 1);
+	    splr->field = ITDB_SPLFIELD_VIDEO_KIND;
+	    splr->action = j ? categories[i].action2 : ITDB_SPLACTION_BINARY_AND;
+	    splr->fromvalue = splr->tovalue = j ? categories[i].mask2 : categories[i].mask1;
+	    splr->fromunits = splr->tounits = 1;
+	    pl->splrules.rules = g_list_append (pl->splrules.rules, splr);
+	}
+	pl->priv->mhsd5_type = categories[i].mhsd5_type;
+	pl->priv->distinguished_kind = categories[i].kind;
+	itdb_playlist_add_mhsd5_playlist (itdb, pl, -1);
+    }
+}
