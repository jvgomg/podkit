+/* SQLite dates are UTC seconds since 2001; 0 is unset, as is the value
+   libgpod used to write for it */
+static time_t sqlite_time(Itdb_iTunesDB *itdb, gint64 date)
+{
+    if (date == 0 || date == -978307200 - (gint64)itdb->tzoffset)
+	return 0;
+    return (time_t)(date + 978307200);
+}
+
+typedef struct {
+    gpointer object;
+    gint64 v[9];
+} DeviceRow;
+
+/* The rows of @sql (a pid and up to nine numbers) from the device's
+   @name whose pid is in @objects. None if @name exists but cannot be read
+   completely; *unreadable is then set, if given. */
+static GArray *read_device_rows(const gchar *itlpdir, const char *name, const char *sql,
+				GHashTable *objects, gboolean *unreadable)
+{
+    gchar *path = g_build_filename(itlpdir, name, NULL);
+    GArray *rows = g_array_new(FALSE, TRUE, sizeof(DeviceRow));
+    sqlite3 *db = NULL;
+    sqlite3_stmt *stmt = NULL;
+    int rc = SQLITE_DONE;
+
+    if (g_file_test(path, G_FILE_TEST_EXISTS)) {
+	rc = sqlite3_open_v2(path, &db, SQLITE_OPEN_READONLY, NULL);
+	if (rc == SQLITE_OK)
+	    rc = sqlite3_prepare_v2(db, sql, -1, &stmt, NULL);
+	while (rc == SQLITE_OK || rc == SQLITE_ROW) {
+	    DeviceRow row = { NULL };
+	    gint64 pid;
+	    int i;
+
+	    rc = sqlite3_step(stmt);
+	    if (rc != SQLITE_ROW)
+		break;
+	    pid = sqlite3_column_int64(stmt, 0);
+	    row.object = g_hash_table_lookup(objects, &pid);
+	    for (i = 1; i < sqlite3_column_count(stmt) && i <= 9; i++)
+		row.v[i - 1] = sqlite3_column_int64(stmt, i);
+	    if (row.object)
+		g_array_append_val(rows, row);
+	}
+	sqlite3_finalize(stmt);
+	sqlite3_close(db);
+    }
+    g_free(path);
+    if (rc != SQLITE_DONE) {
+	g_array_set_size(rows, 0);
+	if (unreadable)
+	    *unreadable = TRUE;
+    }
+    return rows;
+}
+
+/**
+ * itdb_sqlite_read_device_state:
+ *
+ * iPod nano 6G/7G: take over what the device's SQLite files know beyond the
+ * iTunesDB, so that the tracks show and a write keeps it. The firmware
+ * records plays, skips, ratings, bookmarks and whether a track was started
+ * in Dynamic.itdb, and plays and skips in Play Counts as well, which the
+ * parser has added already: counts take the larger total, the rest the
+ * device's value. Dates are
+ * the exact UTC ones the iTunesDB only has as local wall times.
+ */
+G_GNUC_INTERNAL void itdb_sqlite_read_device_state(Itdb_iTunesDB *itdb)
+{
+    GHashTable *tracks, *playlists;
+    GArray *stats, *items, *locations, *containers;
+    GList *lists[2], *gl;
+    gchar *dir, *itlpdir;
+    guint i;
+
+    if (!itdb_get_mountpoint(itdb) || !itdb_device_is_hashab_nano(itdb->device))
+	return;
+    dir = itdb_get_itunes_dir(itdb_get_mountpoint(itdb));
+    if (!dir)
+	return;
+    itlpdir = g_build_filename(dir, "iTunes Library.itlp", NULL);
+    g_free(dir);
+    tracks = g_hash_table_new(g_int64_hash, g_int64_equal);
+    for (gl = itdb->tracks; gl; gl = gl->next)
+	g_hash_table_insert(tracks, &((Itdb_Track *)gl->data)->dbid, gl->data);
+    playlists = g_hash_table_new(g_int64_hash, g_int64_equal);
+    lists[0] = itdb->playlists;
+    lists[1] = itdb->priv->mhsd5_playlists;
+    for (i = 0; i < 2; i++)
+	for (gl = lists[i]; gl; gl = gl->next)
+	    g_hash_table_insert(playlists, &((Itdb_Playlist *)gl->data)->id, gl->data);
+
+    /* only Dynamic.itdb holds data the device recorded; a write must not
+       replace it unread */
+    stats = read_device_rows(itlpdir, "Dynamic.itdb",
+			     "SELECT item_pid, play_count_user, skip_count_user, play_count_recent, "
+			     "skip_count_recent, date_played, date_skipped, user_rating, bookmark_time_ms, "
+			     "has_been_played FROM item_stats;", tracks, &itdb->priv->dynamic_unread);
+    for (i = 0; i < stats->len; i++) {
+	DeviceRow *row = &g_array_index(stats, DeviceRow, i);
+	Itdb_Track *track = row->object;
+	track->playcount = MAX(track->playcount, row->v[0]);
+	track->skipcount = MAX(track->skipcount, row->v[1]);
+	track->recent_playcount = row->v[2];
+	track->recent_skipcount = row->v[3];
+	/* the later date, when Play Counts reported a newer one */
+	track->time_played = MAX(sqlite_time(itdb, row->v[4]), track->priv->reported_played);
+	track->last_skipped = MAX(sqlite_time(itdb, row->v[5]), track->priv->reported_skipped);
+	track->rating = row->v[6];
+	track->bookmark_time = row->v[7];
+	track->priv->device_played = row->v[8] != 0;
+	if (track->priv->device_played)
+	    track->mark_unplayed = 0x01;
+    }
+    items = read_device_rows(itlpdir, "Library.itdb", "SELECT pid, date_modified FROM item;",
+			     tracks, NULL);
+    for (i = 0; i < items->len; i++) {
+	DeviceRow *row = &g_array_index(items, DeviceRow, i);
+	((Itdb_Track *)row->object)->time_modified = sqlite_time(itdb, row->v[0]);
+    }
+    locations = read_device_rows(itlpdir, "Locations.itdb", "SELECT item_pid, date_created FROM location;",
+				 tracks, NULL);
+    for (i = 0; i < locations->len; i++) {
+	DeviceRow *row = &g_array_index(locations, DeviceRow, i);
+	((Itdb_Track *)row->object)->time_added = sqlite_time(itdb, row->v[0]);
+    }
+    containers = read_device_rows(itlpdir, "Library.itdb", "SELECT pid, date_created FROM container;",
+				  playlists, NULL);
+    for (i = 0; i < containers->len; i++) {
+	DeviceRow *row = &g_array_index(containers, DeviceRow, i);
+	((Itdb_Playlist *)row->object)->timestamp = sqlite_time(itdb, row->v[0]);
+    }
+
+    g_array_free(stats, TRUE);
+    g_array_free(items, TRUE);
+    g_array_free(locations, TRUE);
+    g_array_free(containers, TRUE);
+    g_hash_table_destroy(tracks);
+    g_hash_table_destroy(playlists);
+    g_free(itlpdir);
+}
+
+/* iPod nano 6G/7G: keep the audio and subtitle track choices the device
+   recorded for items still in the library; the post-process commands
+   reset them. */
+static int keep_device_choices(Itdb_iTunesDB *itdb, const char *outpath, const char *itlpdir,
+			       GError **error)
+{
+    gchar *device_file = g_build_filename(itlpdir, "Dynamic.itdb", NULL);
+    gchar *dbf = g_build_filename(outpath, "Dynamic.itdb", NULL);
+    sqlite3 *db = NULL;
+    int res = 0;
+
+    if (itdb->priv->dynamic_unread) {
+	g_set_error(error, ITDB_ERROR, ITDB_ERROR_SQLITE,
+		    "'%s' could not be read when the library was opened, so writing would lose "
+		    "the plays, ratings and bookmarks it holds; remove it to write without them",
+		    device_file);
+	res = -1;
+    } else if (g_file_test(device_file, G_FILE_TEST_EXISTS)) {
+	/* The columns are unqualified: one that the device's item_stats
+	   lacks names the new row's own, which keeps its value. */
+	char *sql = sqlite3_mprintf("ATTACH DATABASE %Q AS device;"
+	    "UPDATE item_stats SET (audio_language, subtitle_language, audio_track_id, subtitle_track_id) = "
+	    "(SELECT audio_language, subtitle_language, audio_track_id, subtitle_track_id "
+	    "FROM device.item_stats d WHERE d.item_pid = item_stats.item_pid) "
+	    "WHERE item_pid IN (SELECT item_pid FROM device.item_stats);", device_file);
+	if (sqlite3_open(dbf, &db) != SQLITE_OK || sqlite3_exec(db, sql, NULL, NULL, NULL) != SQLITE_OK) {
+	    g_set_error(error, ITDB_ERROR, ITDB_ERROR_SQLITE,
+			"cannot keep the track choices in '%s': %s", device_file, sqlite3_errmsg(db));
+	    res = -1;
+	}
+	sqlite3_free(sql);
+	sqlite3_close(db);
+    }
+    g_free(device_file);
+    g_free(dbf);
+    return res;
+}
