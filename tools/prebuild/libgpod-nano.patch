--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -31,6 +31,33 @@ libgpod_la_CFLAGS =
 libgpod_la_LDFLAGS = -version-info $(LIBGPOD_SO_VERSION) -no-undefined
 libgpod_la_CPPFLAGS = -DLIBGPOD_BLOB_DIR=\"$(LIBGPOD_BLOB_DIR)\"
 
+# The vendored HashAB signer for the iPod nano 6G/7G relies on wrapping signed
+# arithmetic. Its global symbols are renamed and hidden, so that they neither
+# clash with other code linked with libgpod nor become part of its interface.
+noinst_LTLIBRARIES = libnanohashab.la
+libnanohashab_la_SOURCES =		\
+	nano_hashab/calcHashAB.c	\
+	nano_hashab/cipher.c		\
+	nano_hashab/cipher_tables.c	\
+	nano_hashab/edonr.c		\
+	nano_hashab/expand.c		\
+	nano_hashab/hash.c		\
+	nano_hashab/reduce.c
+libnanohashab_la_CFLAGS = -fwrapv -fvisibility=hidden
+libnanohashab_la_CPPFLAGS =					\
+	-DcalcHashAB=itdb_hashab_calcHashAB			\
+	-DEdonR256Compress=itdb_hashab_EdonR256Compress		\
+	-DEdonR256Init=itdb_hashab_EdonR256Init			\
+	-Dexpand=itdb_hashab_expand				\
+	-Dhash=itdb_hashab_hash					\
+	-Dreduce=itdb_hashab_reduce				\
+	-Dstage1_cipher=itdb_hashab_stage1_cipher		\
+	-Dstage1_initial_chain=itdb_hashab_stage1_initial_chain	\
+	-Dstage1_profile=itdb_hashab_stage1_profile		\
+	-Dstage2_cipher=itdb_hashab_stage2_cipher		\
+	-Dstage2_profile=itdb_hashab_stage2_profile
+libgpod_la_LIBADD = libnanohashab.la
+
 libgpodincludebase = $(includedir)/gpod-1.0
 libgpodincludedir = $(libgpodincludebase)/gpod
 libgpodinclude_HEADERS = itdb.h
@@ -51,6 +78,15 @@ noinst_HEADERS = 		\
 	itdb_zlib.h		\
 	pixmaps.h		\
 	rijndael.h
+noinst_HEADERS +=		\
+	nano_hashab/byteorder.h		\
+	nano_hashab/calcHashAB.h	\
+	nano_hashab/cipher.h		\
+	nano_hashab/cipher_tables.h	\
+	nano_hashab/edonr.h		\
+	nano_hashab/expand.h		\
+	nano_hashab/hash.h		\
+	nano_hashab/reduce.h
 
 INCLUDES=$(LIBGPOD_CFLAGS)
 LIBS=$(LIBGPOD_LIBS) $(Z_LIBS) -lm
