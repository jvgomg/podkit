+/* The SLst payload of mhod 51 (without the mhod header), which the SQLite
+   library stores as container.smart_criteria */
+G_GNUC_INTERNAL GByteArray *itdb_splrules_build_blob (Itdb_iTunesDB *itdb,
+						     Itdb_SPLRules *splrules)
+{
+    FExport fexp = { 0 };
+    MHODData mhod = { 0 };
+    GByteArray *blob;
+
+    fexp.itdb = itdb;
+    fexp.wcontents = wcontents_new ("");
+    mhod.valid = TRUE;
+    mhod.type = MHOD_ID_SPLRULES;
+    mhod.data.splrules = splrules;
+    mk_mhod (&fexp, &mhod);
+    blob = g_byte_array_sized_new (fexp.wcontents->pos - 24);
+    g_byte_array_append (blob, (guint8 *)fexp.wcontents->contents + 24,
+			 fexp.wcontents->pos - 24);
+    wcontents_free (fexp.wcontents);
+    return blob;
+}
